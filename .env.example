# Copy to .env and fill in. Never commit .env.

# --- Sponsor keys -------------------------------------------------------------
SIE_API_KEY=            # Superlinked SIE serverless (sk-sie-...)
KEENABLE_API_KEY=       # Keenable (keen_...)
BAND_USER_API_KEY=      # Band user API key (band_u_...), full-access scope

# Band agents: register four in the Band web app, or via POST /api/v1/me/agents/register
BAND_READER_AGENT_ID=
BAND_READER_API_KEY=
BAND_ELDER_AGENT_ID=
BAND_ELDER_API_KEY=
BAND_PHARMACIST_AGENT_ID=
BAND_PHARMACIST_API_KEY=
BAND_GUARDIAN_AGENT_ID=
BAND_GUARDIAN_API_KEY=

# --- Cognee (open-source, local) running entirely on Superlinked SIE ----------
LLM_PROVIDER=custom
LLM_MODEL=openai/Qwen/Qwen3.8-27B-FP8
LLM_ENDPOINT=https://api.superlinked.com/v1
LLM_API_KEY=            # same SIE key
STRUCTURED_OUTPUT_FRAMEWORK=instructor
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_ENDPOINT=https://api.superlinked.com/v1
EMBEDDING_API_KEY=      # same SIE key
EMBEDDING_DIMENSIONS=2560
DATA_ROOT_DIRECTORY=/absolute/path/to/repo/.cognee/data
SYSTEM_ROOT_DIRECTORY=/absolute/path/to/repo/.cognee/system
TELEMETRY_DISABLED=true

# Optional: only used to make the demo video narration
ELEVENLABS_API_KEY=
